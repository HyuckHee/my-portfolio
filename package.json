{
  "name": "hyukhee-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:appintoss": "vite --config vite.appintoss.config.ts",
    "build:appintoss": "tsc && vite build --config vite.appintoss.config.ts",
    "appintoss:clean": "node -e \"require('fs').rmSync('dist-appintoss',{recursive:true,force:true})\"",
    "appintoss:build": "npm run appintoss:clean && ait build",
    "appintoss:deploy": "ait deploy"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@apps-in-toss/web-framework": "^2.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
